# ==========================================
# SmartPark Environment Configuration Example
# ==========================================

# Active profile: local (uses in-memory H2) or prod (uses MySQL)
SPRING_PROFILES_ACTIVE=local

# Application Port (Render/Railway/Cloud passes PORT dynamically)
PORT=8080

# Production MySQL Database Configuration (Required when SPRING_PROFILES_ACTIVE=prod)
DB_URL=jdbc:mysql://localhost:3306/smartpark?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USER=smartpark
DB_PASS=smartpark123
